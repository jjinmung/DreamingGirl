%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bcc6f59573e1466da054414124fbf80a, type: 3}
  m_Name: 3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogues:
  - speakerName: "NPC \uC544\uC800\uC528"
    dialogueText: "\uC77C\uB2E8 \uC9C4\uC815\uD558\uACE0.\n\uC5EC\uAE34 \uC790\uB124\uAC00
      \uC0DD\uAC01\uD558\uB294 \uD3C9\uBC94\uD55C \uAFC8\uC740 \uC544\uB2C8\uC57C."
    portrait: {fileID: 0}
    isRight: 0
  - speakerName: "NPC \uC544\uC800\uC528"
    dialogueText: "\uC2DC\uD5D8 \uC2A4\uD2B8\uB808\uC2A4\uAC00 \uC2EC\uD588\uB098
      \uBCF4\uC9C0?"
    portrait: {fileID: 0}
    isRight: 0
  - speakerName: 
    dialogueText: "\uADF8\uAC78 \uC5B4\uB5BB\uAC8C \uC54C\uC544\uC694\u2026?"
    portrait: {fileID: 21300000, guid: e1e0e2bc27a26e6429821cb3715add25, type: 3}
    isRight: 1
  - speakerName: 
    dialogueText: "\uC5EC\uAE30 \uC624\uB294 \uC560\uB4E4, \uB2E4 \uBE44\uC2B7\uD574."
    portrait: {fileID: 0}
    isRight: 0
  - speakerName: 
    dialogueText: "\uC544\uBB34\uD2BC, \uC774 \uB358\uC804\uC740 \uAC04\uB2E8\uD574.\n\uC774
      \uB358\uC804\uC740 \uAC08\uC218\uB85D \uB354 \uAC70\uCE60\uC5B4\uC838."
    portrait: {fileID: 0}
    isRight: 0
  - speakerName: 
    dialogueText: "\uB300\uC2E0\u2026 \uB3CC\uB2E4 \uBCF4\uBA74 \uC790\uB124\uB3C4
      \uC810\uC810 \uAC15\uD574\uC9C4\uB2E4."
    portrait: {fileID: 0}
    isRight: 0
  - speakerName: 
    dialogueText: "\uAC15\uD574\uC9C4\uB2E4\uACE0\uC694? \uB808\uBCA8\uC5C5 \uAC19\uC740
      \uAC70\uC608\uC694?"
    portrait: {fileID: 21300000, guid: e1e0e2bc27a26e6429821cb3715add25, type: 3}
    isRight: 1
  - speakerName: 
    dialogueText: "\uBB50, \uBE44\uC2B7\uD558\uC9C0. \uB9C8\uBB3C \uC7A1\uACE0, \uC120\uD0DD\uD558\uACE0,
      \uBC84\uD2F0\uACE0."
    portrait: {fileID: 0}
    isRight: 0
  - speakerName: 
    dialogueText: "\u2026\u2026."
    portrait: {fileID: 21300000, guid: 707da4a5f82266d40aea1399aa144c2d, type: 3}
    isRight: 1
  - speakerName: 
    dialogueText: "\uBB50, \uAC81\uBA39\uC744 \uAC74 \uC5C6\uC5B4."
    portrait: {fileID: 0}
    isRight: 0
  - speakerName: 
    dialogueText: "\uC5B4\uCC28\uD53C \uCC98\uC74C\uC5D4 \uB2E4 \uBC14\uB2E5\uC5D0\uC11C
      \uAD6C\uB978\uB2E4."
    portrait: {fileID: 0}
    isRight: 0
  - speakerName: 
    dialogueText: "\uC55E\uC5D0 \uBCF4\uC774\uB294 \uB188\uB4E4\uBD80\uD130 \uC815\uB9AC\uD558\uACE0
      \uC640."
    portrait: {fileID: 0}
    isRight: 0
  - speakerName: 
    dialogueText: "\uB358\uC804\uC740 \uCE5C\uC808\uD558\uC9C0 \uC54A\uAC70\uB4E0."
    portrait: {fileID: 0}
    isRight: 0
  eventToRaise: {fileID: 11400000, guid: 255cce2b13bcb3c46935c3db623ed174, type: 2}
